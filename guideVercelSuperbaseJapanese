  pending: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
  in_progress: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
  completed: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300',
}

export function StatusBadge({ status }: { status: string }) {
  const style = STATUS_STYLES[status] ?? 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300'
  return <span className={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium ${style}`}>{status.replace('_', ' ')}</span>
}
```

**b) レスポンシブなテーブル。** モバイル用に別の「カード」レイアウトを作る(コード量が増え、2つの描画経路を同期し続ける必要がある)代わりに、副次的な列をブレークポイントごとに隠す:
```tsx
<th className="hidden px-4 py-3 sm:table-cell">Client</th>
<th className="hidden px-4 py-3 md:table-cell">Assignee</th>
```
タイトル・期限・状態・操作はどの画面幅でも常に表示。テーブル自体も `overflow-x-auto` で囲み、非常に狭い画面でも崩れないようにする。

**c) 検索・フィルター — クライアントコンポーネント不要。** 通常の GET `<form>` が `/?q=...&status=...` へそのまま遷移する。ブラウザがナビゲーションを行うので `onChange`/`useState`/デバウンスは不要:
```tsx
<form action="/" className="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end">
  <input name="q" defaultValue={q} placeholder="Title or client…" className={inputClass} />
  <select name="status" defaultValue={status} className={inputClass}>
    <option value="">All statuses</option>
    {STATUSES.map((s) => <option key={s} value={s}>{s.replace('_', ' ')}</option>)}
  </select>
  <button className={buttonPrimaryClass}>Filter</button>
</form>
```
`Home` は `searchParams`(App Router では `Promise`)から `q`/`status`/`page` を読み取り、クエリを組み立てる:
```ts
const { q = '', status = '', page: pageParam } = await searchParams
const page = Math.max(1, Number(pageParam) || 1)

let query = supabase
  .from('documents')
  .select('id, title, client, due_date, status, assignees(name)', { count: 'exact' })
  .order('due_date', { ascending: true })

// PostgREST の or() フィルター構文で特別な意味を持つ文字
// (カンマは条件の区切り、括弧はグループ化)を除去し、
// 検索語がクエリを壊さないようにする。
const safeQ = q.replace(/[,()]/g, '').trim()
if (safeQ) query = query.or(`title.ilike.%${safeQ}%,client.ilike.%${safeQ}%`)
if (status) query = query.eq('status', status)
```

**d) ページネーション。** `select` に `{ count: 'exact' }` を付け `.range(from, to)` を組み合わせると、1回のリクエストでそのページの行と全体件数の両方が取れる:
```ts
const PAGE_SIZE = 10
const from = (page - 1) * PAGE_SIZE
const { data: documents, count, error } = await query.range(from, from + PAGE_SIZE - 1)
const totalPages = Math.max(1, Math.ceil((count ?? 0) / PAGE_SIZE))
```
`Previous`/`Next` は通常の `<Link>` で、小さなヘルパーが `q` と `status` を引き継ぎ、`page` は 1 でないときだけ URL に付ける(ページ1は素の `/` のまま):
```ts
function pageHref({ q, status, page }: { q: string; status: string; page: number }) {
  const sp = new URLSearchParams()
  if (q) sp.set('q', q)
  if (status) sp.set('status', status)
  if (page > 1) sp.set('page', String(page))
  const qs = sp.toString()
  return qs ? `/?${qs}` : '/'
}
```

> クライアントコンポーネントが不要な理由(第1版):検索・フィルター・ページ送りはすべて GET フォームとリンクだけで表現できていた — アプリの他の部分と同じ「サーバーファースト」なやり方。`useState` もデバウンスも要らず、JavaScript が無効でも動いた。`q`/`status`/`page` が URL に乗るので、その時点の表示状態をブックマーク・共有できるのも利点だった。ステップ16 でこれを見直す:入力しながらリアルタイムに検索するにはやはりクライアントコンポーネントが必要になる。

## ステップ16 — 削除確認、カーソルのフィードバック、全項目対応のリアルタイム検索

**a) 削除には確認が必要。** 破壊的な操作がワンクリックでできてしまうのは事故のもと。修正は submit ボタンだけを包む小さなクライアントコンポーネント — 周りの `<form action={deleteDocument}>`(Server Action)はそのまま:
```tsx
// app/DeleteButton.tsx
'use client'

export function DeleteButton({ className }: { className?: string }) {
  return (
    <button
      type="submit"
      className={className}
      onClick={(e) => {
        if (!confirm('Delete this document? This cannot be undone.')) {
          e.preventDefault()
        }
      }}
    >
      Delete
    </button>
  )
}
```
`confirm()` はユーザーが答えるまでブロックする。キャンセルするとクリックに対して `e.preventDefault()` が呼ばれ、`<button type="submit">` によるフォーム送信が止まる。この程度の一回きりの確認にモーダルライブラリは不要。

**b) ボタンがクリックできるように見えなかった。** ほとんどのブラウザでポインターカーソルが既定で付くのは `<a>` だけ — 普通の `<button>` は何も指定しなければ通常の矢印カーソルのまま。`app/globals.css` にルールを1つ足せば、各 className に `cursor-pointer` を追加して回るのではなく、アプリ内の全ボタンに一括で効く:
```css
button:not(:disabled) {
  cursor: pointer;
}
```

**c) 全項目を検索対象に — そこで突き当たった PostgREST の制限。** 元の検索は `title`/`client` しか見ていなかった。`status` を足すのは簡単だった(同じ `or()` に `ilike` をもう1つ足すだけ)が、`assignees.name` と `due_date` の列で、コードを書く前に REST API へ直接テストして確認した本物の PostgREST の制約に突き当たった:
```bash
# or() フィルターの *内側* では column::type のキャストが拒否される:
curl ".../documents?or=(title.ilike.%25x%25,due_date::text.ilike.%252026%25)"
# → 400 PGRST100 "unexpected \":\" ... failed to parse logic tree"
```
そのため `due_date` はこの方法では部分一致検索できない(そもそも日付の部分一致はあまり意味がない)。`assignees.name` は結合先テーブルの列であり、`or()` は埋め込みリソースの列を直接フィルターできない — そこで先に該当する担当者を検索し、その id で documents を絞り込む:
```ts
const orParts = [
  `title.ilike.%${safeQ}%`,
  `client.ilike.%${safeQ}%`,
  `status.ilike.%${safeQ}%`,
]
const { data: matchingAssignees } = await supabase
  .from('assignees').select('id').ilike('name', `%${safeQ}%`)
if (matchingAssignees?.length) {
  orParts.push(`assignee_id.in.(${matchingAssignees.map((a) => a.id).join(',')})`)
}
query = query.or(orParts.join(','))
```

**d) デバウンス付きのリアルタイム検索。** 「Filter」ボタンを押さなくても入力するだけで結果が更新されてほしい — 1文字ごとに反応する必要があるので、これはクライアントコンポーネントが要る。`app/Filters.tsx` が従来の GET `<form>` を置き換える:
```tsx
'use client'
import { usePathname, useRouter, useSearchParams } from 'next/navigation'
import { useRef, useState, useTransition } from 'react'

const DEBOUNCE_MS = 350

export function Filters({ defaultQ, defaultStatus }: { defaultQ: string; defaultStatus: string }) {
  const router = useRouter()
  const pathname = usePathname()
  const searchParams = useSearchParams()
  const [q, setQ] = useState(defaultQ)
  const [isPending, startTransition] = useTransition()
  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null)

  function navigate(nextQ: string, nextStatus: string) {
    const params = new URLSearchParams(searchParams.toString())
    if (nextQ) params.set('q', nextQ); else params.delete('q')
    if (nextStatus) params.set('status', nextStatus); else params.delete('status')
    params.delete('page')
    startTransition(() => router.replace(`${pathname}?${params.toString()}`))
  }

  function handleQChange(value: string) {
    setQ(value)
    if (debounceRef.current) clearTimeout(debounceRef.current)
    debounceRef.current = setTimeout(() => navigate(value, /* current status */ ''), DEBOUNCE_MS)
  }
  // ...status のセレクトは変更時に navigate(q, value) を即座に呼ぶ(デバウンス不要)
}
```
`useTransition` は URL 更新を低優先度としてマークし、入力のもたつきを防ぎつつ、`isPending` で小さな「Searching…」表示を出す。デバウンスにより、Server Component(と Supabase へのクエリ)は入力を止めてから約350ms後にだけ再実行される。

見落としやすい点が1つ:コンポーネントのローカルな `q`/`status` state は、URL がコンポーネントの *外側* から変わったとき(ブラウザの戻る/進む、貼り付けられたリンクなど)に props へ追従する必要がある。これを `useEffect` で同期すると React の `set-state-in-effect` ルール(カスケード的な再レンダー)に引っかかる — 修正は、render 中に直接 state を調整する方法で、React 自身がこのケースでは安全だと明言している:
```tsx
const [prevDefaultQ, setPrevDefaultQ] = useState(defaultQ)
if (defaultQ !== prevDefaultQ) {
  setPrevDefaultQ(defaultQ)
  setQ(defaultQ)
}
```

> 結果:4つの変更のうち3つ(削除確認・カーソル・検索対象の拡大)はクライアント側の state を一切必要としなかった。「入力しながら検索」だけが本当にクライアントコンポーネントを要求する — それ以外はサーバーファーストのまま。

## ステップ17 — 遅く感じる箇所にローディング状態を出す

`/` と `/documents/[id]/edit` はどちらも、何かを描画する前に Supabase のクエリを待つ(前者は一覧+件数+担当者検索、後者は `.single()` での1行取得)。そのため、これらのページに出入りする際、画面に何も起きていないように見える本当の「間」がある。このネットワーク往復そのものはなくせないが、*体感の*待ち時間はなくせる:App Router の `loading.tsx` というファイル規約は、ルートセグメントを自動的に `<Suspense>` 境界で包む。Next.js はナビゲーション直後にこのファイルを表示し、データが解決した瞬間に本物のページへ差し替える。クライアント側の state もスピナーの手配線も不要 — ファイルを正しく命名するだけ:

```tsx
// app/loading.tsx — Home の Supabase クエリが実行中に表示される
export default function Loading() {
  return (
    <main className="mx-auto max-w-5xl animate-pulse p-4 sm:p-8">
      <div className="h-8 w-56 rounded bg-gray-200 dark:bg-gray-800" />
      {/* …ツールバーとテーブル行の形をしたスケルトンバー… */}
    </main>
  )
}
```
```tsx
// app/documents/[id]/edit/loading.tsx — 行の取得中に表示される
export default function Loading() {
  return (
    <main className="mx-auto max-w-md animate-pulse p-4 sm:p-8">
      {Array.from({ length: 5 }).map((_, i) => (
        <div key={i} className="mb-4 h-10 rounded-md bg-gray-200 dark:bg-gray-800" />
      ))}
    </main>
  )
}
```

各スケルトンは実際のページに合わせたサイズ(同じ max-width、同じ行数・項目数)にしてあるので、本物のコンテンツに差し替わってもガタつかない。`/new` と `/login` には用意していない — どちらもビルド時に静的にプリレンダーされ済みで、`loading.tsx` がカバーすべきデータ取得の「間」がそもそも無いため。

> 補足:これが滑らかにするのは *ルート間の* ナビゲーション(`/`・`/new`・`/documents/[id]/edit` 間の `<Link>` クリック)だけ。ステップ16 のリアルタイム検索は、`Filters` の `isPending` + 「Searching…」表示という自前のその場ローディングを既に持っており、`useTransition` で包んでいるのはまさに、1文字入力するたびにこのルートレベルの fallback が出ないようにするため。

---

**まとめ:** Supabase = 出来合いのバックエンド(DB + API + 認証)、Vercel = グローバルなフロント + git ベースのテスト→本番フロー。自分はページとクエリを書くだけ。VM を自前で運用する方式に比べ、最速・最安である理由がこれ。